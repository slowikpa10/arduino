#include <Wire.h>


void setup () {
Serial . begin (115200) ;
Wire . begin () ; //uruchamianie komunikacji I2C

Serial . println ( " Skanowanie magistrali I2C ... " ) ;
for ( byte address = 1; address < 127; address ++) {
  Wire . beginTransmission ( address ) ; //przygotowanie transmisji do urządzenia o wskazanym adresie.
  byte error = Wire . endTransmission () ; // Arduino kończy transmisję i sprawdza, czy urządzenie odpowiedziało. jesli error==0 to urzadzenie odpowiedzialo
if ( error == 0) {
  Serial . print ( " Znaleziono urzadzenie : 0 x " ) ;
if ( address < 16) Serial . print ( " 0 " ) ; //jesli address jest mniejszy niz 16, Arduino dopisuje zero
  Serial . println ( address , HEX ) ; //zapisujemy w systemie 16 
}
}
}

void loop () {
}
