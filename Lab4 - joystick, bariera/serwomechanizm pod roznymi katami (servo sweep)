#include <Servo.h>

Servo myServo;
const int SERVO_PIN = 6;

void setup(){
  myServo.attach(SERVO_PIN);
}

void loop(){
  myServo.write(0);
  delay(1000);
  myServo.write(90);
  delay(1000);
  myServo.write(180);
  delay(1000);
  myServo.write(90);
  delay(1000);
  myServo.write(0);
  delay(1000);
  
}
