#include <Servo.h>
const int TRIG_PIN = 7; //uruchamia pomiar
const int ECHO_PIN = 8; //mierzy czas
const int SERVO_PIN = 6;
// Funkcja mierząca odległość
float measureDistanceCm() {

  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH); #rozpoczynamy pomiar 
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW); #konczymy pomiar 

  unsigned long duration = pulseIn(ECHO_PIN, HIGH, 30000); //mierzy, jak długo sygnał na pinie ECHO pozostaje w stanie HIGH, i zapisuje ten czas

  // 4. Sprawdzenie, czy pomiar się udał
  if (duration == 0) {
    return -1;
  }


  // 6. Zwrócenie odległości
  return duration/58.0;
}

void setup() {
  Serial.begin(115200);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
}

void loop() {
  float distance = measureDistanceCm();

  Serial.print("Odleglosc: ");
  Serial.print(distance);
  Serial.println(" cm");

  delay(200);
}
