const int button = 2;
const int led1 = 8;
const int led2 = 9;

int licznik = 0;
int poprzedni_stan = HIGH;

void setup() {
    pinMode(button, INPUT_PULLUP);
    pinMode(led1, OUTPUT);
    pinMode(led2, OUTPUT);
}

void loop() {
    int stan1 = digitalRead(button);
    delay(20);
    int stan2 = digitalRead(button);

    if (stan1 == stan2) {

        if (poprzedni_stan == HIGH && stan2 == LOW) {

            licznik++;

            if (licznik == 1) {
                digitalWrite(led1, HIGH);
            }
            else if (licznik == 2) {
                digitalWrite(led2, HIGH);
            }
            else if (licznik == 3) {
                digitalWrite(led1, LOW);
                digitalWrite(led2, LOW);
                licznik = 0; //Zerujemy licznik, żeby następne naciśnięcie znowu było traktowane jako pierwsze.
            }
        }

        poprzedni_stan = stan2;
    }
}
