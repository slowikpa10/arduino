const int LED_PIN =8;
const int button_pin = 2;
void setup()
{
  pinMode(LED_PIN, OUTPUT);
  pinMode(button_pin, INPUT_PULLUP);
}

void loop()
{
  
  if (digitalRead(2) == LOW){
    printf("LED jest wlaczona");
    digitalWrite(LED_PIN, HIGH);
    delay(20);
  }
  else{
    printf("LED jest wylaczona");
    digitalWrite(LED_PIN, LOW);
    delay(20);
  }
    
  
  
}
