const int button = 2;
int poprzedni_stan = HIGH;
int licznik = 1;

void setup() {
    pinMode(button, INPUT_PULLUP);
}

void loop() {
    int stan1 = digitalRead(button);
    delay(20);
    int stan2 = digitalRead(button);

    if (stan1 == stan2) {
        if (poprzedni_stan == HIGH && stan2 == LOW) {
            licznik++;

            if (licznik > 3) {
                licznik = 1;
            }
        }
        poprzedni_stan = stan2;
    }

    if (licznik == 1) {
        // Dzialanie 1
    }
    else if (licznik == 2) {
        // Dzialanie 2
    }
    else if (licznik == 3) {
        // Dzialanie 3
    }
}
