
#include "config.h"

AdafruitIO_Feed *led = io.feed("led");
const int LED_PIN = 8;

void handleMessage(AdafruitIO_Data *data) { //funkcja jest wykonywana, kiedy Arduino otrzyma wiadomość z feedu led
  int state = data->toInt(); //Weź otrzymaną wiadomość i zamień ją na liczbę całkowitą.

  if (state == 1) {
    digitalWrite(LED_PIN, HIGH);
  }
  else {
    digitalWrite(LED_PIN, LOW);
  }
}

void setup() {
  // put your setup code here, to run once:
  Serial.begin(115200);
  while (!Serial)
    ;

  Serial.print("Connecting to Adafruit IO");
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW); //ustawia początkowo stan niski, czyli gasi diodę

  io.connect(); //Rozpoczyna połączenie z Adafruit IO.
  led->onMessage(handleMessage); // Kiedy przyjdzie wiadomość z feedu led, wykonaj funkcję handleMessage

  while (io.mqttStatus() < AIO_CONNECTED) { //Arduino czeka na połączenie MQTT z Adafruit IO.
    Serial.print(".");
    delay(500);
  }

  led->get(); //Prosi Adafruit IO o ostatnią zapisaną wartość feedu led.

  // we are connected
  Serial.println();
  Serial.println(io.statusText());
}

void loop() {
  
  io.run(); //funkcja handleMessage() działa jako tzw. callback — funkcja wywoływana w odpowiedzi na zdarzenie.
}
