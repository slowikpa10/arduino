
#include "config.h"

AdafruitIO_Feed *temperature = io.feed("temperature"); //nasz FEED w adafruit

void setup() {
  // put your setup code here, to run once:
  Serial.begin(115200);
  while (!Serial) //Dopóki komunikacja Serial nie jest gotowa, czekaj.
    ; //Samotny średnik ; oznacza, że pętla nie wykonuje żadnych dodatkowych instrukcji.

  Serial.print("Connecting to Adafruit IO");

  io.connect(); //polaczenie w adafruit 

  while (io.status() < AIO_CONNECTED) { //czekanie na polaczenie 
    Serial.print(".");
    delay(500);
  }

  Serial.println();
  Serial.println(io.statusText());
}

void loop() {
  int raw = analogRead(A0);
  float voltage = raw * 5.0 / 1023.0;
  float temperatureC = voltage * 100.0;

  io.run(); // obsługuje komunikację z Adafruit IO.

  Serial.print("sending -> ");
  Serial.println(temperatureC);
  temperature->save(temperatureC); //wysyła wartość temperatury do feedu Adafruit IO.

  // increment the count by 1
  delay(5000);
}
